@model Bloggie.Web.Models.ViewModels.EditBlogPostRequest
@{
}


<div class="bg-secondary bg-opacity-10 py-2">
    <div class="container">
        <h1>Edit New BlogPost - Admin Functionality</h1>
    </div>
</div>

<div class="container py-5">
    @if (Model != null)
    {
        <form method="post">
            <div class="mb-3">
                <label class="form-label">Id</label>
                <input type="text" class="form-control" asp-for="Id" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Heading</label>
                <input type="text" class="form-control" asp-for="Heading" />
            </div>

            <div class="mb-3">
                <label class="form-label">Page Title</label>
                <input type="text" class="form-control" asp-for="PageTitle" />
            </div>

            <div class="mb-3">
                <label class="form-label">Content</label>
                <textarea class="form-control" asp-for="Content"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Short Description</label>
                <input type="text" class="form-control" asp-for="ShortDescription" />
            </div>

            <div class="mb-3">
                <label class="form-label">Featured ImageUrl</label>
                <input type="text" class="form-control" asp-for="FeaturedImageUrl" />
            </div>

            <div class="mb-3">
                <label class="form-label">URL Handle</label>
                <input type="text" class="form-control" asp-for="UrlHandle" />
            </div>

            <div class="mb-3">
                <label class="form-label">Published Date</label>
                <input type="date" class="form-control" asp-for="PublishedDate" />
            </div>

            <div class="mb-3">
                <label class="form-label">Author</label>
                <input type="text" class="form-control" asp-for="Author" />
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="Visible" />
                <label class="form-check-label">Is Visible?</label>
            </div>


            <div class="mb-3">
                <label class="form-label">Tags</label>
                <select multiple class="form-select" asp-for="SelectedTags" asp-items="@Model.Tags">
                </select>
            </div>


            <div class="mb-3 d-flex">
                <button type="submit" class="btn btn-dark">Edit</button>

                <button type="submit" class="btn btn-danger ms-2" 
                    asp-controller="AdminBlogPosts" asp-action="Delete" >Delete</button>
            </div>

        </form>
    }
    else
    {
        <p>No blog post found!</p>
    }
</div> 