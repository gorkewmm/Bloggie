@model Bloggie.Web.Models.ViewModels.EditTagRequest
@{
}

<div class="bg-secondary bg-opacity-10 py-2">
    <div class="container">
        <h1>Edit Tag - Admin Functionality</h1>
    </div>
</div>

<div class="container py-5">
    @if(Model != null)
    {
        <form method="post">
            <div class="mb-3">
                <label class="form-label">Id</label>
                <input type="text" asp-for="Id" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Name</label>
                <input type="text" asp-for="Name" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Display Name</label>
                <input type="text" class="form-control" asp-for="DisplayName" />
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-dark">Edit</button>

                <button type="submit" class="btn btn-danger ms-2"
                        asp-controller="AdminTags" asp-action="Delete">
                    Delete
                </button>
            </div>

        </form>
    }
    else
    {
        <p>Tag not found</p>
    }
</div>
