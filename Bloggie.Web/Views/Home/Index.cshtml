@model Bloggie.Web.Models.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<div class="container col-xxl-8 px-4 py-5">
    <div class="row align-items-center g-5 py-5">

        <!-- Hero Content -->
        <div class="col-12 col-lg-6">

            <div class="mb-3">
                <span class="badge bg-dark rounded-pill px-3 py-2">
                    Developer Blog
                </span>
            </div>

            <h1 class="display-4 fw-bold lh-1 mb-4">
                Gorkem's
                <span class="text-dark">Dev Blog</span>
            </h1>

            <p class="lead text-muted mb-4">
                Exploring the world of .NET, one line of code at a time.
                Writing about ASP.NET, C#, Entity Framework Core, and
                Microsoft technologies through practical examples,
                real-world solutions, and lessons learned along the way.
            </p>

            <div class="d-flex flex-wrap gap-2 mb-4">
                <span class="badge bg-light text-dark border px-3 py-2">
                    ASP.NET
                </span>

                <span class="badge bg-light text-dark border px-3 py-2">
                    C#
                </span>

                <span class="badge bg-light text-dark border px-3 py-2">
                    .NET
                </span>

                <span class="badge bg-light text-dark border px-3 py-2">
                    EF Core
                </span>
            </div>

            <p class="text-muted mb-0">
                <small>
                    Build. Learn. Share.
                </small>
            </p>

        </div>

        <!-- Hero Image -->
        <div class="col-12 col-lg-6">

            <div class="position-relative">
                <img src="https://images.pexels.com/photos/8524586/pexels-photo-8524586.jpeg"
                     alt="Developer workspace"
                     class="d-block mx-lg-auto img-fluid rounded-4 shadow"
                     width="500"
                     loading="lazy" />
            </div>

        </div>

    </div>
</div>


